generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per human identity. A Person can exist in school data independent of
// whether they have a login (User) yet - kept thin for now (see RoleAssignment
// for how login accounts get their role/school).
model Person {
  id          String   @id @default(cuid())
  fullName    String
  dateOfBirth String?
  gender      String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  user User?
}

// A school/tenant. Single-tenant in practice today (one row), but every
// place a school affiliation matters gets a real FK to this, not a shortcut.
model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  roleAssignments RoleAssignment[]
  classes         Class[]
}

// Role now lives on RoleAssignment (one user can eventually hold several);
// User itself only identifies the login account.
model User {
  id           String    @id @default(cuid())
  personId     String    @unique
  person       Person    @relation(fields: [personId], references: [id])
  email        String?   @unique
  username     String?   @unique
  passwordHash String
  name         String
  avatar       String    @default("🧒")
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  roleAssignments RoleAssignment[]
  studentProfile  StudentProfile?
  teacherClasses  Class[]                     @relation("TeacherClasses")
  guardianLinks   GuardianStudentRelationship[] @relation("ParentSide")
}

// The source of truth for "what role does this account have" - replaces the
// old User.role scalar. One user can (eventually) hold multiple assignments;
// scopeType/scopeId are reserved for later per-class/subject/period scoping
// and are always null for now.
model RoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  scopeType   String?
  scopeId     String?
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// One row per student. Mirrors the old localStorage `S` shape so nothing
// meaningful from the client app is lost when it starts talking to the API.
model StudentProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
  birthdate      String?
  grade          Int     @default(1)
  xp             Int     @default(0)
  level          Int     @default(1)
  streak         Int     @default(0) // consecutive days played
  lastPlayedDate String?
  maxStreak      Int     @default(0) // best in-game combo ever
  totalGames     Int     @default(0)
  correctAnswers Int     @default(0)
  totalQuestions Int     @default(0)
  fastestTime    Int     @default(999)
  unlockedGrades String  @default("[1]") // JSON-encoded array of grade numbers
  sound          Boolean @default(true)
  vibrate        Boolean @default(true)
  linkCode       String  @unique // shown to the student, used by a parent to link their account

  gradeProgress    GradeProgress[]
  sessions         GameSession[]
  exams            ExamAttempt[]
  achievements     StudentAchievement[]
  classEnrollments ClassEnrollment[]
  guardianLinks    GuardianStudentRelationship[] @relation("StudentSide")
}

// Per grade + sub-level completion/star rating (replaces S.gp[grade].subs[sub]).
model GradeProgress {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  grade     Int
  subLevel  Int
  done      Boolean        @default(false)
  stars     Int            @default(0)

  @@unique([studentId, grade, subLevel])
}

// A finished GameSession IS a history record - no separate History table needed.
model GameSession {
  id         String    @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id])
  grade      Int
  subLevel   Int
  isExam     Boolean   @default(false)
  status     String    @default("active") // active | finished
  score      Int       @default(0)
  correct    Int       @default(0)
  wrong      Int       @default(0)
  maxStreak  Int       @default(0)
  duration   Int?
  accuracy   Int?
  xpEarned   Int?
  createdAt  DateTime  @default(now())
  lastActivityAt DateTime @default(now()) // bumped on each answer; used to time the NEXT answer server-side
  finishedAt DateTime?

  questions SessionQuestion[]
}

// Server holds the answer key; the client is only ever sent question/options/id.
model SessionQuestion {
  id           String    @id @default(cuid())
  sessionId    String
  session      GameSession @relation(fields: [sessionId], references: [id])
  index        Int
  questionText String
  category     String
  answerKey    String // never sent to the client
  options      String? // JSON-encoded array, null when useInput
  useInput     Boolean   @default(false)
  answeredAt   DateTime?
  submitted    String?
  isCorrect    Boolean?
  answerMs     Int?
  scoreEarned  Int?

  @@unique([sessionId, index])
}

model ExamAttempt {
  id          String    @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  grade       Int
  score       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
}

model StudentAchievement {
  id            String   @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  achievementId String
  unlockedAt    DateTime @default(now())

  @@unique([studentId, achievementId])
}

// Teacher-owned roster. Students self-enroll with the joinCode.
model Class {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  grade     Int
  joinCode  String   @unique
  createdAt DateTime @default(now())

  enrollments ClassEnrollment[]
}

model ClassEnrollment {
  id        String         @id @default(cuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  joinedAt  DateTime       @default(now())

  @@unique([classId, studentId])
}

// Parent gets read-only visibility into a student's progress via a link code.
// Claiming a code is inherently self-verifying, so verificationStatus defaults
// to VERIFIED - there's no separate approval step today.
model GuardianStudentRelationship {
  id                     String         @id @default(cuid())
  parentId               String
  parent                 User           @relation("ParentSide", fields: [parentId], references: [id])
  studentId              String
  student                StudentProfile @relation("StudentSide", fields: [studentId], references: [id])
  relationshipType       String         @default("PARENT")
  legalGuardian          Boolean        @default(true)
  pickupPermission       Boolean        @default(false)
  emergencyContact       Boolean        @default(false)
  verificationStatus     String         @default("VERIFIED")
  communicationPriority  Int            @default(1)
  linkedAt               DateTime       @default(now())

  @@unique([parentId, studentId])
}
